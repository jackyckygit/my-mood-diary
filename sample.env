# PostgreSQL Configuration
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# Backend API Configuration
DB_HOST=db         # The service name from docker-compose.yml or the hostname of an external PostgreSQL database
DB_PORT=5432
JWT_SECRET=your_jwt_secret
OPENROUTER_API_KEY=your_openrouter_api_key

# Port mapping
FRONTEND_PORT=3000
BACKEND_PORT=5000

# image tag
IMAGE_TAG_API=1.0.0
IMAGE_TAG_CLIENT=1.0.0